{
  "product": "DashTron",
  "type": "service-verify",
  "v": 4,
  "protects": [
    {
      "channel": "service",
      "manifest": "https://raw.githubusercontent.com/jameng9/serviceJMCU/main/firmware-service/manifest.json"
    }
  ],
  "verify": {
    "url": "https://raw.githubusercontent.com/jameng9/serviceJMCU/main/codes/codes.json",
    "path": "codes/codes.json",
    "algo": "sha256",
    "salt": "dashtron-svc-v1",
    "input": "salt|CODE|EXP_SECONDS",
    "output": "hex-lowercase",
    "normalize": "uppercase, keep A-Z and 0-9 only (CODE)",
    "match": "no board ID: for each entry in codes[] compute the hash with that entry's exp and compare with h; unlock on the first match",
    "code_length": 16,
    "expiry": {
      "field": "exp",
      "unit": "unix-ms",
      "rule": "unlock only if now < exp (use NTP time); EXP_SECONDS = floor(exp/1000) as decimal string",
      "allowed_days": [
        1,
        30
      ]
    }
  }
}